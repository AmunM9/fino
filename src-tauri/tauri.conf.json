{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fino",
  "mainBinaryName": "Fino",
  "version": "0.1.0",
  "identifier": "app.fino.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fino",
        "width": 1000,
        "height": 660,
        "minWidth": 880,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#111317",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Photography",
    "shortDescription": "Smaller photos that look exactly the same",
    "copyright": "© 2026 The Shipping Labs",
    "publisher": "The Shipping Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "jfif"
        ],
        "contentTypes": [
          "public.jpeg"
        ],
        "name": "JPEG image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif",
          "hif"
        ],
        "contentTypes": [
          "public.heic",
          "public.heif"
        ],
        "name": "HEIC image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.folder"
        ],
        "name": "Folder",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
